APP_NAME=FinPilot AI API
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local MongoDB URI. Keep credentials out of source control.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=finpilot
MONGODB_TIMEOUT_MS=10000
SOURCE_CONTENT_DIRECTORY=knowledge_bases/source_documents

# Nugen requests are made only by explicitly running the inference check or
# calling a client method. The API key is never written into source control.
NUGEN_API_KEY=
NUGEN_API_BASE_URL=https://api.nugen.in
NUGEN_TIMEOUT_SECONDS=30
NUGEN_GET_RETRIES=1
NUGEN_TEST_MODEL_ID=
NUGEN_TAX_MODEL_ID=
NUGEN_INVESTMENT_MODEL_ID=
NUGEN_INSURANCE_MODEL_ID=
# Optional, disabled by default. A separate inference-ready model may be used
# for quote-anchored claim assessment; each factual sentence can cost one call.
NUGEN_CLAIM_VERIFIER_MODEL_ID=
